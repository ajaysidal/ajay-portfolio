generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model minimal {
  id String @id
  createdAt DateTime @default(now())
}

model User {
  id String @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime?
}

model ConsultationBooking {
  id String @id @default(uuid())
  createdAt DateTime @default(now())
  fullName String?
  email String?
  phone String?
  companyName String?
  businessType String?
  primaryPain String?
  desiredOutcome String?
  budgetRange String?
  timeline String?
  status String @default("pending")
  ipHash String?
  userAgent String?
  userId String?
}

model ProjectIntake {
  id String @id @default(uuid())
  createdAt DateTime @default(now())
  fullName String?
  email String?
  companyName String?
  companyWebsite String?
  currentTechStack String?
  primaryPainPoints String?
  desiredOutcomes String?
  budgetRange String?
  timeline String?
  scopeOfWork String?
  status String @default("pending")
  ipHash String?
  userAgent String?
  userId String?
}

model DashboardMetrics {
  id String @id @default(uuid())
  createdAt DateTime @default(now())
  pageViewed String?
  consultationId String?
  projectIntakeId String?
  userId String?
  ipHash String?
}